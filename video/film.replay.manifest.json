{
  "version": 1,
  "output": {
    "width": 2560,
    "height": 1440,
    "fps": 60,
    "maxSeconds": 180
  },
  "product": {
    "url": "http://localhost:3000/?film=1",
    "resetStorage": true,
    "chromePosition": "1707,0"
  },
  "narration": {
    "voice": "en-US-AndrewMultilingualNeural",
    "rate": "-6%",
    "pitch": "-2Hz",
    "gainDb": -1
  },
  "music": {
    "gainDb": -16,
    "duckDb": -7,
    "seed": 7
  },
  "shots": [
    {
      "id": "new-project",
      "title": "Create Pipeline",
      "seconds": 10,
      "stage": "gallery",
      "steps": [
        {
          "pointer": {
            "x": 0.5,
            "y": 0.56
          }
        },
        {
          "wait": 500
        },
        {
          "click": ".new-project-button"
        },
        {
          "waitFor": "#new-project-title"
        },
        {
          "type": "#new-project-title",
          "value": "Pipeline",
          "settleMs": 350,
          "enter": false
        },
        {
          "click": ".project-create-submit"
        },
        {
          "waitFor": ".tool-ledger"
        },
        {
          "wait": 450
        }
      ],
      "transitionOut": "bridge"
    },
    {
      "id": "agent-replay",
      "title": "One shared mathematical world",
      "seconds": 132,
      "steps": [
        {
          "click": ".rail-pin"
        },
        {
          "wait": 250
        },
        {
          "writeInk": true
        },
        {
          "wait": 600
        },
        {
          "startReplay": true,
          "wait": 400
        },
        {
          "pauseReplayAfter": "resizes the ellipse with its handles",
          "timeoutMs": 300000,
          "wait": 350
        },
        {
          "click": ".kind-shape.is-selected"
        },
        {
          "wait": 300
        },
        {
          "drag": ".selection-handle[data-handle=\"se\"]",
          "px": {
            "dx": 70,
            "dy": 35
          },
          "durationMs": 900
        },
        {
          "wait": 250
        },
        {
          "drag": ".selection-handle[data-handle=\"rotate\"]",
          "px": {
            "dx": 55,
            "dy": 22
          },
          "durationMs": 800
        },
        {
          "wait": 400
        },
        {
          "resumeReplay": true,
          "wait": 300
        },
        {
          "pauseReplayAfter": "drags the arrow head",
          "timeoutMs": 300000,
          "wait": 350
        },
        {
          "click": "[data-object-id=\"replay_arrow\"]"
        },
        {
          "wait": 300
        },
        {
          "drag": ".node-handle.is-arrow-end[data-node-index=\"1\"]",
          "px": {
            "dx": 90,
            "dy": -45
          },
          "durationMs": 900
        },
        {
          "wait": 400
        },
        {
          "resumeReplay": true,
          "wait": 300
        },
        {
          "pauseReplayAfter": "clicks Undo in the rail",
          "timeoutMs": 300000,
          "wait": 350
        },
        {
          "click": ".rail-button[aria-label=\"Undo\"]"
        },
        {
          "wait": 1400
        },
        {
          "resumeReplay": true,
          "wait": 300
        },
        {
          "awaitReplay": true,
          "timeoutMs": 420000
        },
        {
          "wait": 700
        },
        {
          "hover": ".tool-ledger"
        },
        {
          "wait": 4200
        },
        {
          "pointer": {
            "x": 0.5,
            "y": 0.55
          }
        },
        {
          "wait": 700
        },
        {
          "showLockup": true,
          "wait": 400
        },
        {
          "wait": 3600
        }
      ],
      "transitionOut": "end"
    }
  ],
  "narrationSpec": "scripts/film/narration-v3.json"
}
