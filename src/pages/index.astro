---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Mathos turns mistakes into evidence-backed learning paths." />
    <title>Mathos — Learn what your answer reveals</title>
  </head>
  <body>
    <main class="entry-shell">
      <nav aria-label="Primary">
        <a class="wordmark" href="/">MATHOS<span>·</span></a>
        <span class="edition">Learning system / 01</span>
      </nav>
      <section>
        <p class="eyebrow">Adaptive mathematics, without the theater</p>
        <h1>Your wrong answer<br />is <em>useful evidence.</em></h1>
        <p class="intro">Mathos reads the structure behind an answer, teaches the missing idea, and checks it on something new.</p>
        <a class="enter" href="/learn">
          Enter the learning studio
          <span aria-hidden="true">↗</span>
        </a>
      </section>
      <footer>
        <span>Calculus → vectors → a tiny transformer</span>
        <span>Session 001</span>
      </footer>
    </main>
  </body>
</html>

<style>
  .entry-shell {
    width: min(1240px, calc(100% - 40px));
    min-height: 100vh;
    margin: 0 auto;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  nav,
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .wordmark {
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.16em;
  }

  .wordmark span {
    color: var(--orange);
  }

  .edition {
    color: var(--muted);
  }

  section {
    align-self: center;
    padding: 72px 0;
  }

  .eyebrow {
    margin: 0 0 22px;
    color: var(--orange);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 950px;
    margin: 0;
    font: 400 clamp(54px, 8.5vw, 124px) / 0.88 var(--serif);
    letter-spacing: -0.065em;
  }

  h1 em {
    color: var(--orange);
    font-weight: 400;
  }

  .intro {
    max-width: 580px;
    margin: 34px 0 0 20%;
    color: var(--muted);
    font: 400 clamp(18px, 2vw, 24px) / 1.45 var(--serif);
  }

  .enter {
    width: fit-content;
    margin: 44px 0 0 20%;
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 15px 18px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .enter:hover {
    background: var(--orange);
    color: white;
    transform: translateY(-2px);
  }

  footer {
    border-top: 1px solid var(--rule);
    border-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .entry-shell {
      width: min(100% - 32px, 1240px);
    }

    .edition,
    footer span:last-child {
      display: none;
    }

    section {
      padding: 56px 0;
    }

    h1 {
      font-size: clamp(48px, 16vw, 70px);
    }

    .intro,
    .enter {
      margin-left: 0;
    }

    .intro {
      font-size: 19px;
    }
  }
</style>
